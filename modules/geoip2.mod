id = 'geoip2'
env = 'GEOIP'
kind = 'archive'
dir = 'ngx_http_geoip2_module'
versioned_dir = 'yes'
version_var = 'GEOIP2_VER'
version = '3.4'
repo = 'leev/ngx_http_geoip2_module'
url = 'https://github.com/leev/ngx_http_geoip2_module/archive/3.4.tar.gz'
strip = '1'
sha256 = ''
ref = ''
submodules = 'no'
build = '--add-module={dir}'
requires = 'libmaxminddb'
license = 'BSD-2-Clause'
status = 'active'
