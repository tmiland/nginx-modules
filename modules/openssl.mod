id = 'openssl'
env = 'OPENSSL'
kind = 'archive'
dir = 'openssl'
versioned_dir = 'yes'
version_var = 'OPENSSL_VER'
version = '3.5.1'
repo = 'openssl/openssl'
url = 'https://www.openssl.org/source/openssl-3.5.1.tar.gz'
strip = '1'
sha256 = ''
ref = ''
submodules = 'no'
build = '--with-openssl={dir}'
requires = ''
license = 'Apache-2.0'
status = 'active'
