id = 'lua-nginx'
env = 'LUA'
kind = 'archive'
dir = 'lua-nginx-module'
versioned_dir = 'yes'
version_var = 'LUA_NGINX_VER'
version = '0.10.28'
repo = 'openresty/lua-nginx-module'
url = 'https://github.com/openresty/lua-nginx-module/archive/v0.10.28.tar.gz'
strip = '1'
sha256 = ''
ref = ''
submodules = 'no'
build = '--add-module={dir}'
requires = 'luajit2,ngx-devel-kit'
license = 'BSD-2-Clause'
status = 'active'
