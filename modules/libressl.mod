id = 'libressl'
env = 'LIBRESSL'
kind = 'archive'
dir = 'libressl'
versioned_dir = 'yes'
version_var = 'LIBRESSL_VER'
version = '4.1.0'
repo = 'libressl/portable'
url = 'http://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-4.1.0.tar.gz'
strip = '1'
sha256 = ''
ref = ''
submodules = 'no'
build = '--with-openssl={dir}'
requires = ''
license = 'ISC AND OpenSSL'
status = 'active'
